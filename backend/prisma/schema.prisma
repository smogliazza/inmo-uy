// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// The connection URL is configured in prisma.config.ts (Migrate) and src/lib/prisma.ts (runtime).
datasource db {
  provider = "postgresql"
}

// UYU pesos, USD dollars, UI unidades indexadas, UR unidades reajustables
enum Currency {
  UYU
  USD
  UI
  UR
}

// ─── Organization ─────────────────────────────────────────────────────────────

model Organization {
  id                String   @id @default(uuid())
  name              String
  subscription      SubTier  @default(BASIC)
  // Default changed to "es" for the Uruguay platform (existing rows keep their value)
  preferredLanguage String   @default("es")
  // Uruguay localization (spec 6.3 / 7)
  country           String   @default("UY")
  timezone          String   @default("America/Montevideo")
  defaultCurrency   Currency @default(USD)
  customDomain      String?  @unique // the brokerage's own domain (phase F5)
  whatsapp          String?
  siteConfig        Json?            // public site: theme, home page, pages, social links, hours (phase F5)
  isDemo            Boolean  @default(false)
  demoExpiresAt     DateTime?
  website           String?
  address           String?
  phone             String?
  licenseNumber     String?
  logoUrl           String?
  // Settings > CRM / Properties / Finance / Appointments / Documents policies (validated and defaulted in src/lib/policies.ts)
  policies          Json?
  // Public web address of the brokerage's listings page: /public-listings?b=<slug>
  slug              String?  @unique
  brandColor        String?
  // Commission defaults applied when a deal closes (percent values, e.g. 3 = 3%)
  defaultCommissionRate Float @default(3)
  defaultFirmSplit      Float @default(30)
  // Security policy, enforced by the auth middleware, login and password flows (0 days = passwords never expire)
  sessionTimeoutMinutes      Int     @default(1440)
  minPasswordLength          Int     @default(8)
  requirePasswordSpecialChar Boolean @default(false)
  passwordExpiryDays         Int     @default(0)
  logoutOnPasswordChange     Boolean @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  users          User[]
  clients        Client[]
  properties     Property[]
  transactions   Transaction[]
  commissions    Commission[]
  offers         Offer[]
  documents      Document[]
  appointments   Appointment[]
  mediaAssets    MediaAsset[]
  marketingTasks MarketingTask[]
  referrals      Referral[]
  giftOrders     GiftOrder[]
  tasks          Task[]
  notes          Note[]
  notifications  Notification[]
  auditLogs        AuditLog[]
  invitations      Invitation[]
  uploadedFiles    UploadedFile[]
  leadRoutingRules LeadRoutingRule[]
  slugHistory      OrgSlugHistory[]
}

enum SubTier {
  BASIC
  PRO
  ENTERPRISE
}

// ─── User ─────────────────────────────────────────────────────────────────────

model User {
  id                String       @id @default(uuid())
  email             String       @unique
  password          String?
  googleId          String?      @unique
  appleId           String?      @unique
  name              String
  role              Role         @default(AGENT)
  tier              Tier         @default(CORE)
  preferredLanguage String       @default("es")
  orgId             String
  organization      Organization @relation(fields: [orgId], references: [id])
  // Set when the password is reset; null = never changed since the account was created
  passwordChangedAt DateTime?

  // Profile fields
  avatarUrl     String?
  phone         String?
  title         String?
  licenseNumber String?
  linkedIn      String?
  bio           String?
  timezone      String   @default("America/Montevideo")

  // Auth fields
  passwordResetToken  String?
  passwordResetExpiry DateTime?
  emailVerifyToken    String?
  emailVerified       Boolean  @default(false)
  isActive            Boolean  @default(true)
  acceptingLeads      Boolean  @default(true)
  maxActiveLeads      Int?
  notificationPrefs   Json?
  // Personal Settings > "My preferences" (validated and defaulted in src/lib/policies.ts)
  preferences         Json?
  lastLoginAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clients        Client[]
  properties     Property[]
  transactions   Transaction[]
  commissions    Commission[]
  offers         Offer[]
  appointments   Appointment[]
  marketingTasks MarketingTask[]
  referralsGiven Referral[]      @relation("Referrer")
  referralsRecv  Referral[]      @relation("Referee")
  giftOrders     GiftOrder[]
  tasks          Task[]
  notes          Note[]
  notifications  Notification[]
  auditLogs      AuditLog[]
}

enum Role {
  SUPERADMIN
  FIRMADMIN
  MANAGER
  AGENT
  ATTORNEY
  LENDER
  TITLECO
  MARKETING
  OFFICE_SUPPORT
}

enum Tier {
  CORE
  PRO
  ELITE
}

// ─── Client ──────────────────────────────────────────────────────────────────

model Client {
  id             String       @id @default(uuid())
  firstName      String
  lastName       String
  email          String?
  phone          String?
  type           ClientType   @default(BUYER)
  status         ClientStatus @default(ACTIVE)
  funnelStage    ClientFunnel @default(LEAD)

  // Extended fields
  source              String?   // Referral, Zillow, StreetEasy, Website, etc.
  tags                String?   // Comma-separated tags
  notes               String?   // Quick notes field
  budget              String?
  targetMoveDate      DateTime?
  lastContactedAt     DateTime?
  preferredContact    String?   // email | phone | text | any
  referredBy          String?   // free-text referrer name
  coAgentId           String?   // co-agent on same client
  temperature         String?   @default("WARM") // HOT | WARM | COLD — lead priority
  // Uruguay (spec 6.3)
  documentType        IdDocumentType?
  documentNumber      String?
  whatsapp            String?
  searchCriteria      Json?     // "Díganos lo que busca": operation, types, cities, price range, bedrooms
  consentAt           DateTime? // data-protection consent from a public form (Ley 18.331)

  agentId      String
  agent        User         @relation(fields: [agentId], references: [id])
  orgId        String
  organization Organization @relation(fields: [orgId], references: [id])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  transactions Transaction[]
  offers       Offer[]
  appointments Appointment[]
  giftOrders   GiftOrder[]
  clientNotes  Note[]
}

enum ClientType {
  BUYER
  SELLER
  REFERRAL
  RENTER
  INVESTOR
  OWNER
  TENANT
}

enum IdDocumentType {
  CI
  RUT
  PASSPORT
  OTHER
}

enum ClientStatus {
  LEAD
  ACTIVE
  IN_CONTRACT
  CLOSED
  ARCHIVED
}

enum ClientFunnel {
  LEAD
  QUALIFIED
  SHOWING
  OFFERING
  IN_CONTRACT
  CLOSED
  ARCHIVED
}

// ─── Property ────────────────────────────────────────────────────────────────

model Property {
  id          String     @id @default(uuid())
  address     String
  city        String
  state       String?    // in Uruguay: the department (Salto, Montevideo…)
  zip         String?
  price       Float?     // legacy: kept in sync with PropertyPrice (sale price, else rent) for reports and commissions
  beds        Float?
  baths       Float?
  sqft        Int?       // deprecated for Uruguay: builtAreaM2 replaces it
  description String?
  status      PropStatus @default(ACTIVE)

  // Extended fields
  propertyType    String?   // catalog in src/lib/catalogs.ts (APARTAMENTO, CASA, CAMPO_CHACRA… and the legacy New York types)
  neighborhood    String?
  yearBuilt       Int?
  mlsNumber       String?
  hoaFee          Float?    // gastos comunes; currency in hoaFeeCurrency
  parkingSpaces   Int?      // deprecated alias: garageSpaces replaces it
  virtualTourUrl  String?
  featuredImage   String?
  featured        Boolean  @default(false)
  listingDate     DateTime?
  expirationDate  DateTime?
  daysOnMarket    Int?

  agentId      String
  agent        User         @relation(fields: [agentId], references: [id])
  orgId        String
  organization Organization @relation(fields: [orgId], references: [id])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  transactions  Transaction[]
  offers        Offer[]
  appointments  Appointment[]
  mediaAssets   MediaAsset[]
  propertyNotes Note[]

  // ── Uruguay (spec 6.2): every column optional ──
  code           String?        // the brokerage's own code ("COD.")
  slug           String?        // friendly URL part
  isPublic       Boolean        @default(true)
  locality       String?        // locality / neighbourhood when city is the department capital
  lat            Float?
  lng            Float?
  geoPrecision   GeoPrecision   @default(EXACT)
  builtAreaM2    Float?
  landArea       Float?
  landAreaUnit   AreaUnit?
  garageSpaces   Int?
  amenities      String[]       @default([])
  hoaFeeCurrency Currency?
  padron         String?        // cadastral number
  furnished      Boolean        @default(false)
  externalSource String?        // 'inmobiliariaya' | 'csv' | ...
  externalId     String?
  externalUrl    String?
  importedAt     DateTime?
  prices         PropertyPrice[]

  @@unique([orgId, code])
  @@unique([orgId, externalSource, externalId])
  @@index([orgId, isPublic, status])
  @@index([orgId, lat, lng])
}

enum GeoPrecision {
  EXACT
  APPROX
  HIDDEN
}

enum AreaUnit {
  M2
  HA
}

// One row per operation: a property can be for sale and for rent at the same time (spec 6.2)
model PropertyPrice {
  id         String      @id @default(uuid())
  propertyId String
  property   Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  orgId      String
  operation  Operation
  amount     Decimal?    @db.Decimal(14, 2) // null + onRequest = "Consultar"
  currency   Currency    @default(USD)
  period     RentPeriod? // rentals only
  onRequest  Boolean     @default(false)
  isActive   Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@unique([propertyId, operation])
  @@index([orgId, operation, isActive, amount])
}

enum Operation {
  SALE
  RENT
  SEASONAL_RENT
}

enum RentPeriod {
  MONTH
  WEEK
  NIGHT
  SEASON
}

enum PropStatus {
  COMING_SOON
  ACTIVE
  IN_CONTRACT
  SOLD
  WITHDRAWN
  EXPIRED
  RESERVED
  RENTED
}

// ─── Transaction ─────────────────────────────────────────────────────────────

model Transaction {
  id         String      @id @default(uuid())
  propertyId String
  property   Property    @relation(fields: [propertyId], references: [id])
  clientId   String
  client     Client      @relation(fields: [clientId], references: [id])
  agentId    String
  agent      User        @relation(fields: [agentId], references: [id])
  orgId      String
  organization Organization @relation(fields: [orgId], references: [id])
  price      Float
  status     TransStatus @default(OFFER_REVIEW)

  // Timeline fields
  acceptedPrice     Float?
  contractDate      DateTime?
  inspectionDate    DateTime?
  boardPackageDate  DateTime?
  clearToCloseDate  DateTime?
  closingDate       DateTime?
  contingencies     String?   // comma-separated: FINANCING, INSPECTION, APPRAISAL, SALE_OF_HOME
  notes             String?
  coAgentId         String?   // co-broker agent
  commissionRate    Float?    // percent of sale price; falls back to org default

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  commissions       Commission[]
  documents         Document[]
  transactionNotes  Note[]
}

enum TransStatus {
  OFFER_REVIEW
  IN_CONTRACT
  BOARD_PACKAGE
  CLEARED_TO_CLOSE
  CLOSED
  FALLEN_THROUGH
}

// ─── Commission ──────────────────────────────────────────────────────────────

model Commission {
  id               String      @id @default(uuid())
  transactionId    String
  transaction      Transaction @relation(fields: [transactionId], references: [id])
  agentId          String
  agent            User        @relation(fields: [agentId], references: [id])
  orgId            String
  organization     Organization @relation(fields: [orgId], references: [id])
  grossAmount      Float
  firmSplitPercent Float
  overridePercent  Float
  netPayout        Float
  status           CommStatus  @default(PENDING)
  paidAt           DateTime?
  notes            String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

enum CommStatus {
  PENDING
  REQUESTED
  PAID
  DISPUTED
}

// ─── Offer ───────────────────────────────────────────────────────────────────

model Offer {
  id           String      @id @default(uuid())
  amount       Float
  status       OfferStatus @default(PENDING)
  notes        String?
  expiresAt    DateTime?
  counterAmount Float?
  propertyId   String
  property     Property    @relation(fields: [propertyId], references: [id])
  clientId     String
  client       Client      @relation(fields: [clientId], references: [id])
  agentId      String
  agent        User        @relation(fields: [agentId], references: [id])
  orgId        String
  organization Organization @relation(fields: [orgId], references: [id])
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  COUNTER
  WITHDRAWN
  EXPIRED
}

// ─── Document ────────────────────────────────────────────────────────────────

model Document {
  id            String      @id @default(uuid())
  name          String
  url           String
  type          String      // CONTRACT | INSPECTION | APPRAISAL | BOARD_PACKAGE | ID | DISCLOSURE | OTHER
  sizeBytes     Int?
  mimeType      String?
  storageKey    String?
  version       Int         @default(1)
  signatureRequired Boolean @default(false)
  signedAt      DateTime?

  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id])
  uploadedById  String?
  orgId         String
  organization  Organization @relation(fields: [orgId], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

// ─── Appointment ─────────────────────────────────────────────────────────────

model Appointment {
  id     String        @id @default(uuid())
  title  String
  date   DateTime
  endDate DateTime?
  notes  String?
  status AppointStatus @default(SCHEDULED)
  type   ApptType      @default(MEETING)

  // Extended fields
  durationMin       Int?     @default(60)
  location          String?
  virtualLink       String?
  confirmationSent  Boolean  @default(false)
  reminderSent      Boolean  @default(false)
  colorCode         String?

  agentId      String
  agent        User          @relation(fields: [agentId], references: [id])
  clientId     String?
  client       Client?       @relation(fields: [clientId], references: [id])
  propertyId   String?
  property     Property?     @relation(fields: [propertyId], references: [id])
  orgId        String
  organization Organization  @relation(fields: [orgId], references: [id])
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

enum AppointStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
}

enum ApptType {
  SHOWING
  MEETING
  CALL
  OPEN_HOUSE
  INSPECTION
  CLOSING
  FOLLOW_UP
}

// ─── MediaAsset ──────────────────────────────────────────────────────────────

model MediaAsset {
  id         String   @id @default(uuid())
  url        String
  type       String   // image | video | floorplan | 3d_tour
  caption    String?
  sortOrder  Int      @default(0)
  sizeBytes  Int?
  mimeType   String?
  storageKey String?
  variants   Json?    // WebP sizes: { thumb, md, lg } → { url, width, height, storageKey }
  width      Int?
  height     Int?
  sourceUrl  String?  // where an imported photo came from
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])
  orgId      String
  organization Organization @relation(fields: [orgId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ─── MarketingTask ───────────────────────────────────────────────────────────

model MarketingTask {
  id           String       @id @default(uuid())
  title        String
  content      String?
  status       String       @default("PENDING")  // PENDING | IN_PROGRESS | PUBLISHED | ARCHIVED
  channel      String?      // email | instagram | facebook | linkedin | twitter
  scheduledAt  DateTime?
  publishedAt  DateTime?
  agentId      String
  agent        User         @relation(fields: [agentId], references: [id])
  orgId        String
  organization Organization @relation(fields: [orgId], references: [id])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

// ─── Referral ────────────────────────────────────────────────────────────────

model Referral {
  id           String       @id @default(uuid())
  referrerId   String
  referrer     User         @relation("Referrer", fields: [referrerId], references: [id])
  refereeId    String
  referee      User         @relation("Referee", fields: [refereeId], references: [id])
  status       String       @default("PENDING")  // PENDING | ACCEPTED | PAID
  feeAmount    Float?
  notes        String?
  orgId        String
  organization Organization @relation(fields: [orgId], references: [id])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

// ─── GiftOrder ───────────────────────────────────────────────────────────────

model GiftOrder {
  id           String       @id @default(uuid())
  item         String
  status       String       @default("ORDERED")  // ORDERED | SHIPPED | DELIVERED | CANCELLED
  amount       Float?
  trackingNum  String?
  deliveredAt  DateTime?
  clientId     String
  client       Client       @relation(fields: [clientId], references: [id])
  agentId      String
  agent        User         @relation(fields: [agentId], references: [id])
  orgId        String
  organization Organization @relation(fields: [orgId], references: [id])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

// ─── Task (Agent To-Do) ───────────────────────────────────────────────────────

model Task {
  id          String     @id @default(uuid())
  title       String
  description String?
  status      TaskStatus @default(PENDING)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  completedAt DateTime?
  overdueNotified Boolean  @default(false)

  // Linked entities (all optional)
  linkedClientId      String?
  linkedPropertyId    String?
  linkedTransactionId String?

  agentId      String
  agent        User         @relation(fields: [agentId], references: [id])
  orgId        String
  organization Organization @relation(fields: [orgId], references: [id])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// ─── Note ────────────────────────────────────────────────────────────────────

model Note {
  id      String @id @default(uuid())
  content String
  type    String @default("NOTE")  // NOTE | CALL | EMAIL | MEETING | SHOWING | SYSTEM

  // Linked to one of these (all optional, at least one expected)
  clientId      String?
  client        Client?      @relation(fields: [clientId], references: [id])
  propertyId    String?
  property      Property?    @relation(fields: [propertyId], references: [id])
  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id])

  authorId     String
  author       User         @relation(fields: [authorId], references: [id])
  orgId        String
  organization Organization @relation(fields: [orgId], references: [id])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

// ─── Notification ─────────────────────────────────────────────────────────────

model Notification {
  id        String           @id @default(uuid())
  type      NotifType
  title     String
  message   String
  readAt    DateTime?
  link      String?          // deep-link path e.g. /crm/123
  metadata  String?          // JSON blob for extra context

  userId       String
  user         User         @relation(fields: [userId], references: [id])
  orgId        String
  organization Organization @relation(fields: [orgId], references: [id])
  createdAt    DateTime     @default(now())
}

enum NotifType {
  NEW_CLIENT
  OFFER_RECEIVED
  OFFER_ACCEPTED
  OFFER_REJECTED
  APPOINTMENT_REMINDER
  TRANSACTION_UPDATE
  COMMISSION_PAID
  TASK_DUE
  DOCUMENT_SIGNED
  SYSTEM
}

// ─── Invitation ──────────────────────────────────────────────────────────────

model Invitation {
  id          String    @id @default(uuid())
  email       String
  role        String    @default("AGENT")
  token       String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  invitedById String?

  orgId        String
  organization Organization @relation(fields: [orgId], references: [id])
  createdAt    DateTime     @default(now())
}

// ─── AuditLog ────────────────────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(uuid())
  action    String   // CREATE_CLIENT, UPDATE_ROLE, DELETE_PROPERTY, etc.
  entity    String   // Client | User | Property | Transaction | etc.
  entityId  String?
  before    String?  // JSON snapshot before change
  after     String?  // JSON snapshot after change
  ipAddress String?
  userAgent String?

  userId       String
  user         User         @relation(fields: [userId], references: [id])
  orgId        String
  organization Organization @relation(fields: [orgId], references: [id])
  createdAt    DateTime     @default(now())
}

// ─── UploadedFile ────────────────────────────────────────────────────────────

model UploadedFile {
  id         String       @id @default(uuid())
  orgId      String
  organization Organization @relation(fields: [orgId], references: [id])
  visibility String       @default("PUBLIC") // PUBLIC | PRIVATE
  filename   String
  mimeType   String
  sizeBytes  Int
  r2Key      String?
  data       Bytes?
  createdAt  DateTime     @default(now())
}

// ─── LeadRoutingRule ─────────────────────────────────────────────────────────

model LeadRoutingRule {
  id            String       @id @default(uuid())
  orgId         String
  organization  Organization @relation(fields: [orgId], references: [id])
  name          String
  priority      Int          @default(0)
  enabled       Boolean      @default(true)
  source        String?      // e.g. Website, Open House, Zillow (null = any)
  city          String?      // e.g. New York, Brooklyn (null = any)
  propertyType  String?      // e.g. CONDO, COOP, TOWNHOUSE (null = any)
  minPrice      Float?
  maxPrice      Float?
  strategy      String       @default("ROUND_ROBIN") // LISTING_AGENT | SPECIFIC_AGENT | ROUND_ROBIN | LEAST_LOADED
  targetAgentId String?
  lastAssignedIndex Int      @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

// ─── OrgSlugHistory ──────────────────────────────────────────────────────────

model OrgSlugHistory {
  id           String       @id @default(uuid())
  oldSlug      String       @unique
  orgId        String
  organization Organization @relation(fields: [orgId], references: [id])
  createdAt    DateTime     @default(now())
}
