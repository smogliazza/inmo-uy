# /opt/inmo-uy/.env.backup — nightly encrypted backup to Cloudflare R2 (deploy/backup/backup.sh)
PGHOST=db
PGUSER=inmo
PGPASSWORD=                            # same as POSTGRES_PASSWORD
PGDATABASE=inmo
BACKUP_TIME=03:30                      # America/Montevideo
KEEP_DAILY=14
KEEP_WEEKLY=8
# R2: a bucket only for backups, with an API token limited to that bucket
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
BACKUP_R2_BUCKET=inmo-backups
# Encryption passphrase: keep a copy OUTSIDE the server (password manager). Without it the backups cannot be read.
BACKUP_ENCRYPTION_KEY=                 # openssl rand -hex 32
# Optional: ping after each successful backup (e.g. https://hc-ping.com/<uuid>) to be alerted when one is missed
BACKUP_HEALTHCHECK_URL=
