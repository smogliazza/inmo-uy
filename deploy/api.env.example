# /opt/inmo-uy/.env.api — API container. Never commit the real file.
NODE_ENV=production
PORT=4000
# Same password as .env.db; connection_limit=10 as tuned for a 2 GB Droplet
DATABASE_URL=postgresql://inmo:CHANGE_ME@db:5432/inmo?schema=public&connection_limit=10
JWT_SECRET=                            # openssl rand -hex 32
FRONTEND_URL=https://app.plataforma.uy # CORS allowlist (comma-separated)
APP_URL=https://app.plataforma.uy      # links in e-mails
TRUST_PROXY=1                          # Caddy in front
PLATFORM_NAME=Plataforma inmobiliaria
# E-mail (Resend)
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM=avisos@plataforma.uy
EMAIL_FROM_NAME=Plataforma inmobiliaria
# Photos and private documents (Cloudflare R2); without them files are kept in the database
STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
# Geocoding
NOMINATIM_URL=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT=inmo-uy/1.0 (ops@plataforma.uy)
# Modules (see backend/src/lib/modules.ts)
MODULES_FORCE_OFF=
MODULES_DEFAULT_ON=
MODULES_DEFAULT_OFF=
SENTRY_DSN=
