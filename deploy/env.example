# /opt/inmo-uy/.env — variables of docker-compose.prod.yml itself (copy to .env and fill in)
PLATFORM_DOMAIN=plataforma.uy          # the panel lives on app.PLATFORM_DOMAIN; brokerages on {slug}.PLATFORM_DOMAIN
ACME_EMAIL=ops@plataforma.uy           # Let's Encrypt account e-mail (expiry notices)
GHCR_OWNER=smogliazza                  # GitHub owner of the images (ghcr.io/OWNER/inmo-uy-*)
# TAG is set by deploy.sh; to run compose by hand: TAG=v1.2.0.0 docker compose -f docker-compose.prod.yml ps
