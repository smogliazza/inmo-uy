# ─────────────────────────────────────────────
#  Real Estate CRM — Frontend Environment Variables
#  On Vercel: set these in Project → Settings → Environment Variables
# ─────────────────────────────────────────────

# Backend API URL (your Render service URL)
NEXT_PUBLIC_API_URL=https://real-estate-agency-crm.onrender.com

# AI assistant is in development; set to "true" together with the backend switch to enable it
NEXT_PUBLIC_AI_ASSISTANT_ENABLED="false"
# Optional: link the homepage "Browse Listings" to this brokerage (slug shown in Settings → Organization)
NEXT_PUBLIC_FEATURED_BROKERAGE_SLUG=""

# Languages offered in the switchers (comma-separated; es = Spanish/Uruguay, en, zh-CN, zh-TW). Default: es,en
NEXT_PUBLIC_SUPPORTED_LOCALES="es,en"
# Language for first-time visitors. Default: es
NEXT_PUBLIC_DEFAULT_LOCALE="es"
# Platform name shown in the page title and metadata (pending the final commercial name)
NEXT_PUBLIC_PLATFORM_NAME="Plataforma inmobiliaria"

# Map style for MapLibre (no API key needed with OpenFreeMap). Default: https://tiles.openfreemap.org/styles/liberty
NEXT_PUBLIC_MAP_STYLE_URL=""

# Optional: Sentry DSN for frontend error reporting (silent when unset)
NEXT_PUBLIC_SENTRY_DSN=""

# Optional: set to "true" to switch frontend CSP from Report-Only to enforced mode
NEXT_PUBLIC_CSP_ENFORCE="false"
